DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
NEXTAUTH_SECRET="gere-uma-string-longa-aleatoria"
NEXTAUTH_URL="http://localhost:3000"
# Producao Vercel (exemplo):
# NEXTAUTH_URL="https://saas-emprestimos-jlri.vercel.app"
# Links no WhatsApp. No PC use localhost; no CELULAR use o IP da rede (rode: npm run url:lan)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Exemplo para testar no celular na mesma Wi‑Fi:
# NEXT_PUBLIC_APP_URL="http://192.168.0.10:3000"

WHATSAPP_PROVIDER="evolution"
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
ZAPI_INSTANCE=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# mercado_pago | asaas | c6 | inter
PIX_PROVIDER="mercado_pago"
MERCADO_PAGO_ACCESS_TOKEN=""
ASAAS_API_KEY=""

# Webhook PIX — header x-webhook-secret (recomendado usar o segredo do banco escolhido)
PIX_WEBHOOK_SECRET=""
PIX_C6_WEBHOOK_SECRET=""
# Opcional: só para testes manuais com header x-webhook-secret (o Inter não envia esse header)
PIX_INTER_WEBHOOK_SECRET=""
# URL pública do webhook (padrão: NEXT_PUBLIC_APP_URL + /api/webhooks/pix/inter)
INTER_WEBHOOK_URL=""

# C6 Bank — PIX Cobrança (auth /v1/auth + REST; mTLS)
# Produção: https://baas-api.c6bank.info | Sandbox: https://baas-api-sandbox.c6bank.info
C6_SANDBOX="false"
C6_API_BASE_URL=""
C6_CLIENT_ID=""
C6_CLIENT_SECRET=""
C6_PIX_KEY=""
C6_MTLS_CERT=""
C6_MTLS_KEY=""
C6_MTLS_CA=""
C6_PIX_EXPIRACAO_SEGUNDOS="180"

# Banco Inter — PIX Cobrança (OAuth client_credentials + mTLS), se PIX_PROVIDER=inter
INTER_API_BASE_URL="https://cdpj.partners.bancointer.com.br"
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
INTER_PIX_KEY=""
INTER_MTLS_CERT=""
INTER_MTLS_KEY=""
INTER_MTLS_CA=""
INTER_MTLS_CERT_PATH=""
INTER_MTLS_KEY_PATH=""
INTER_MTLS_CA_PATH=""
# PIX/cobrança (padrão no código): cob.read cob.write pix.read pix.write
INTER_OAUTH_SCOPE=""
# Só se for cadastrar webhook e a integração tiver permissão webhook
INTER_OAUTH_SCOPE_WEBHOOK=""
INTER_PIX_EXPIRACAO_SEGUNDOS="180"

CRON_SECRET=""
# Senha do admin criado pelo seed (opcional; padrão no seed.js)
SEED_ADMIN_PASSWORD=""



