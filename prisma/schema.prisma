generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StatusEmprestimo {
  ativo
  quitado
  inadimplente
}

enum StatusParcela {
  pendente
  paga
  vencida
}

enum MetodoPagamento {
  pix
}

enum TipoOcupacao {
  comerciante
  motorista_app
  autonomo
  funcionario_clt
  outro
}

enum StatusDespesaParcela {
  pendente
  paga
}

enum FrequenciaParcela {
  diario
  semanal
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cliente {
  id                  String        @id @default(cuid())
  nome                String
  cpf                 String        @unique
  endereco            String
  whatsapp            String
  tipo_ocupacao       TipoOcupacao?
  ocupacao_detalhe    String?
  origem_cadastro     String?
  referencia1_nome    String?
  referencia1_telefone String?
  referencia2_nome    String?
  referencia2_telefone String?
  created_at          DateTime      @default(now())
  emprestimos         Emprestimo[]
}

model WhatsappConversa {
  id         String   @id @default(cuid())
  telefone   String   @unique
  etapa      String
  dados      Json     @default("{}")
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
}

model Despesa {
  id              String           @id @default(cuid())
  descricao       String
  valor_total     Decimal          @db.Decimal(12, 2)
  parcelado       Boolean          @default(false)
  numero_parcelas Int              @default(1)
  created_at      DateTime         @default(now())
  parcelas        DespesaParcela[]
}

model DespesaParcela {
  id             String               @id @default(cuid())
  despesa_id     String
  numero_parcela Int
  valor          Decimal              @db.Decimal(12, 2)
  vencimento     DateTime
  data_pagamento DateTime?
  status         StatusDespesaParcela @default(pendente)
  despesa        Despesa              @relation(fields: [despesa_id], references: [id], onDelete: Cascade)

  @@unique([despesa_id, numero_parcela])
  @@index([status])
  @@index([vencimento])
  @@index([status, vencimento])
}

enum TipoMovimentacaoCaixa {
  novo_emprestimo
  renovacao
  recebimento
}

model ConfigCaixa {
  id            String   @id @default("default")
  saldo_inicial Decimal  @default(0) @db.Decimal(12, 2)
  updated_at    DateTime @updatedAt
}

model MovimentacaoCaixa {
  id            String                @id @default(cuid())
  tipo          TipoMovimentacaoCaixa
  valor         Decimal               @db.Decimal(12, 2)
  descricao     String?
  emprestimo_id String?
  parcela_id    String?
  pagamento_id  String?               @unique
  created_at    DateTime              @default(now())
  emprestimo    Emprestimo?           @relation(fields: [emprestimo_id], references: [id], onDelete: SetNull)

  @@index([tipo])
  @@index([created_at])
}

model Emprestimo {
  id                    String           @id @default(cuid())
  cliente_id            String
  valor_emprestado      Decimal          @db.Decimal(12, 2)
  valor_principal_base  Decimal?         @db.Decimal(12, 2)
  taxa_juros_percentual Decimal          @db.Decimal(5, 2)
  numero_parcelas       Int
  valor_parcela         Decimal          @db.Decimal(12, 2)
  data_inicio           DateTime
  vencimento_dia        Int
  multa_percentual      Decimal          @default(2) @db.Decimal(5, 2)
  juros_dia_percentual  Decimal          @default(0.33) @db.Decimal(5, 2)
  status                StatusEmprestimo @default(ativo)
  frequencia_parcela    FrequenciaParcela @default(semanal)
  created_at            DateTime         @default(now())
  cliente               Cliente          @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  parcelas              Parcela[]
  movimentacoes_caixa   MovimentacaoCaixa[]

  @@index([created_at])
  @@index([status, created_at])
}

model Parcela {
  id              String        @id @default(cuid())
  emprestimo_id   String
  numero_parcela  Int
  valor_original  Decimal       @db.Decimal(12, 2)
  vencimento      DateTime
  data_pagamento  DateTime?
  dias_atraso     Int           @default(0)
  multa_valor     Decimal       @default(0) @db.Decimal(12, 2)
  juros_valor     Decimal       @default(0) @db.Decimal(12, 2)
  valor_atualizado Decimal      @default(0) @db.Decimal(12, 2)
  status          StatusParcela @default(pendente)
  avisos_antecipados Int        @default(0)
  avisos_vencimento  Int        @default(0)
  avisos_atraso      Int        @default(0)
  ultimo_aviso_em    DateTime?
  encargos_isentos   Boolean    @default(false)
  juros_isentos      Boolean    @default(false)
  emprestimo      Emprestimo    @relation(fields: [emprestimo_id], references: [id], onDelete: Cascade)
  pagamentos      Pagamento[]

  @@unique([emprestimo_id, numero_parcela])
  @@index([status])
  @@index([vencimento])
  @@index([status, vencimento])
  @@index([emprestimo_id, status])
}

model Pagamento {
  id             String          @id @default(cuid())
  parcela_id     String
  valor_pago     Decimal         @db.Decimal(12, 2)
  metodo         MetodoPagamento @default(pix)
  transaction_id String          @unique
  data_pagamento DateTime        @default(now())
  status         String
  parcela        Parcela         @relation(fields: [parcela_id], references: [id], onDelete: Restrict)

  @@index([status])
}
